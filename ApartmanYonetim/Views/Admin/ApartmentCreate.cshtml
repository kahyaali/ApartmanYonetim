@{
    ViewData["Title"] = "Yeni Daire";
}


<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Yeni Daire Ekle</h4>
    <a asp-action="Apartments" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="ApartmentCreate" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Blok</label>
                <select name="BlockId" class="form-select">
                    <option value="">Blok Seçiniz</option>
                    @foreach (SelectListItem item in ViewBag.Bloklar)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-size:13px;">Kat</label>
                <input name="Kat" class="form-control" type="number"
                       min="0" max="50" placeholder="Örn: 2" />
            </div>
            <div class="col-md-3">
                <label class="form-label" style="font-size:13px;">Daire No</label>
                <input name="DaireNo" class="form-control" type="number"
                       min="1" placeholder="Örn: 5" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Daire Tipi</label>
                <select name="Tipi" class="form-select">
                    <option value="">Seçiniz</option>
                    <option value="1+1">1+1</option>
                    <option value="2+1">2+1</option>
                    <option value="3+1">3+1</option>
                    <option value="4+1">4+1</option>
                    <option value="Dubleks">Dubleks</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Metrekare</label>
                <input name="MetreKare" class="form-control" type="number"
                       step="0.5" min="1" placeholder="Örn: 85" />
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </form>
</div>