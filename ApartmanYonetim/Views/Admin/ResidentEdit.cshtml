@model ApartmanYonetim.Models.ViewModels.ResidentViewModel
@{
    ViewData["Title"] = "Sakin Düzenle";
}


<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-user-edit me-2"></i>Sakin Düzenle</h4>
  
    <a asp-action="Residents" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="ResidentEdit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Ad</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"
                      style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Soyad</label>
                <input asp-for="Soyad" class="form-control" />
                <span asp-validation-for="Soyad" class="text-danger"
                      style="font-size:12px;"></span>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Daire</label>
                <select name="ApartmentId" class="form-select">
                    <option value="">Daire Seçiniz</option>
                    @foreach (SelectListItem item in ViewBag.Daireler)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.ApartmentId.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Taşınma Tarihi</label>
                <input asp-for="TasinmaTarihi" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Ayrılma Tarihi</label>
                <input asp-for="AyrilmaTarihi" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Durum</label>
                <select asp-for="AktifMi" class="form-select">
                    <option value="true">Aktif (Oturuyor)</option>
                    <option value="false">Ayrıldı</option>
                </select>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </form>
</div>