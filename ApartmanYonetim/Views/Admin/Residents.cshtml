@model List<ApartmanYonetim.Models.Entities.Resident>
@{
    ViewData["Title"] = "Sakinler";
}


<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-users me-2"></i>Apartman Sakinleri</h4>
    
    <a asp-action="ResidentCreate" class="btn btn-sm"
           style="background:#1e3a5f;color:#fff;border-radius:8px;">
        <i class="fas fa-plus me-1"></i>Yeni Sakin
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-card">
    <div class="table-responsive">
        <table id="tblSakinler" class="table table-hover align-middle" style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Daire No</th>
                    <th>Taşınma Tarihi</th>
                    <th>Ayrılma Tarihi</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:34px;height:34px;border-radius:50%;
                                    background:#e8f4fd;display:flex;align-items:center;
                                    justify-content:center;font-size:13px;
                                    color:#2d6a9f;font-weight:600;flex-shrink:0;">
                                    @s.Ad[0]@s.Soyad[0]
                                </div>
                                <div>
                                    <div style="font-weight:600;">@s.Ad @s.Soyad</div>
                                </div>
                            </div>
                        </td>
                        <td><strong>Daire @s.Apartment?.DaireNo</strong></td>
                        <td>@s.TasinmaTarihi.ToString("dd.MM.yyyy")</td>
                        <td>@(s.AyrilmaTarihi.HasValue? s.AyrilmaTarihi.Value.ToString("dd.MM.yyyy") : "-")</td>
                        <td>
                            @if (s.AktifMi)
                            {
                                <span class="badge" style="background:#eafaf1;color:#27ae60;">Aktif</span>
                            }
                            else
                            {
                                <span class="badge" style="background:#fdf2f2;color:#e74c3c;">Ayrıldı</span>
                            }
                        </td>
                        <td>
                            <a asp-action="ResidentEdit" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-primary" style="font-size:11px;">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="ResidentDelete" asp-route-id="@s.Id"
                                  method="post" class="d-inline">
                                <button type="button"
                                        onclick="sakinSil(@s.Id, '@s.Ad @s.Soyad')"
                                        class="btn btn-sm btn-outline-danger"
                                        style="font-size:11px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tblSakinler').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
                },
                pageLength: 10,
                order: [[2, 'desc']]
            });
        });

         function sakinSil(id, ad) {
               showConfirm(`"${ad}"  silmek istediğinize emin misiniz?`)
                   .then(onay => {
                       if (!onay) return;
                       const form = document.createElement('form');
                       form.method = 'POST';
                       form.action = `/Admin/ResidentDelete/${id}`;
                       const token = document.querySelector(
                           'input[name="__RequestVerificationToken"]')?.value;
                       if (token) {
                           const inp = document.createElement('input');
                           inp.type = 'hidden';
                           inp.name = '__RequestVerificationToken';
                           inp.value = token;
                           form.appendChild(inp);
                       }
                       document.body.appendChild(form);
                       form.submit();
                   });
           }
    </script>
}