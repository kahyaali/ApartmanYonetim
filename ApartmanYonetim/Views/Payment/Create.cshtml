@model ApartmanYonetim.Models.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Yeni Ödeme Kaydı";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Yeni Ödeme Kaydı</h4>
  
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Daire</label>
                <select asp-for="ApartmentId" class="form-select">
                    <option value="">Daire Seçiniz</option>
                    @foreach (var d in ViewBag.Daireler as List<ApartmanYonetim.Models.Entities.Apartment>)
                    {
                        <option value="@d.Id">
                            @(d.Block != null ? d.Block.Ad + " - " : "")Daire @d.DaireNo
                        </option>
                    }
                </select>
                <span asp-validation-for="ApartmentId" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <select asp-for="Aciklama" class="form-select">
                    <option value="">Seçiniz</option>
                    <option value="Aylık Aidat">Aylık Aidat</option>
                    <option value="Su">Su</option>
                    <option value="Doğalgaz">Doğalgaz</option>
                    <option value="Elektrik">Elektrik (Ortak Alan)</option>
                    <option value="Asansör Bakım">Asansör Bakım</option>
                    <option value="Temizlik">Temizlik</option>
                    <option value="Diğer">Diğer</option>
                </select>
                <span asp-validation-for="Aciklama" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Toplam Tutar (₺)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">₺</span>
                    <input asp-for="Tutar" class="form-control" type="number" step="0.01" placeholder="0.00" />
                </div>
                <span asp-validation-for="Tutar" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Son Ödeme Tarihi</label>
                <input asp-for="SonOdemeTarihi" class="form-control" type="date" />
                <span asp-validation-for="SonOdemeTarihi" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-12">
                <div class="alert mb-0" style="background:#e8f4fd;border:none;border-radius:10px;font-size:13px;">
                    <i class="fas fa-info-circle me-2" style="color:#2d6a9f;"></i>
                    Kayıt oluşturduktan sonra <strong>Detay</strong> sayfasından ödeme hareketleri ekleyebilirsiniz.
                </div>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </form>
</div>