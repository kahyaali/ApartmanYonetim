<!-- Views/Odeme/Odeme.cshtml -->
@model ApartmanYonetim.Models.ViewModels.OdemeBaslatViewModel
@{
    ViewData["Title"] = "Online Ödeme";
    var payment = ViewBag.Payment as ApartmanYonetim.Models.Entities.Payment;
}

<div class="page-header">
    <h4><i class="fas fa-credit-card me-2"></i>Online Ödeme</h4>
    <a asp-controller="Payment" asp-action="MyPayments"
           class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="row g-4">
    <!-- Ödeme Özeti -->
    <div class="col-md-4">
        <div class="table-card">
            <h6 class="mb-3" style="font-weight:600;color:#1e3a5f;">
                <i class="fas fa-receipt me-2"></i>Ödeme Özeti
            </h6>
            <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                <div class="d-flex justify-content-between mb-2"
                     style="font-size:13px;">
                    <span style="color:#718096;">Açıklama:</span>
                    <strong>@payment?.Aciklama</strong>
                </div>
                <div class="d-flex justify-content-between mb-2"
                     style="font-size:13px;">
                    <span style="color:#718096;">Toplam Borç:</span>
                    <strong>@payment?.Tutar.ToString("N2") ₺</strong>
                </div>
                <div class="d-flex justify-content-between mb-2"
                     style="font-size:13px;">
                    <span style="color:#718096;">Ödenen:</span>
                    <strong style="color:#27ae60;">
                        @payment?.OdenenTutar.ToString("N2") ₺
                    </strong>
                </div>
                <hr style="border-color:#e2e8f0;" />
                <div class="d-flex justify-content-between"
                     style="font-size:16px;">
                    <span style="font-weight:600;">Ödenecek:</span>
                    <strong style="color:#e74c3c;">
                        @payment?.KalanTutar.ToString("N2") ₺
                    </strong>
                </div>
            </div>

            <div class="mt-3" style="font-size:12px;color:#a0aec0;text-align:center;">
                <i class="fas fa-lock me-1"></i>
                256-bit SSL şifreli güvenli ödeme
            </div>
            <div class="mt-2 text-center">
                <img src="https://www.iyzico.com/assets/images/iyzico_ile_ode.png"
                     style="height:30px;" alt="iyzico"
                     onerror="this.style.display='none'" />
            </div>
        </div>
    </div>

    <!-- Kart Bilgileri -->
    <div class="col-md-8">
        <div class="table-card">
            <h6 class="mb-4" style="font-weight:600;color:#1e3a5f;">
                <i class="fas fa-credit-card me-2"></i>Kart Bilgileri
            </h6>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3" style="font-size:13px;">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <form asp-action="OdemeYap" method="post" id="odemeForm">
                <input type="hidden" name="PaymentId" value="@Model.PaymentId" />
                <input type="hidden" name="Tutar"
                       value="@payment?.KalanTutar.ToString("F2",
                                                                  System.Globalization.CultureInfo.InvariantCulture)" />

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">
                            Kart Sahibinin Adı
                        </label>
                        <input name="KartSahibi" class="form-control"
                               value="@Model.KartSahibi"
                               placeholder="Ad Soyad"
                               style="text-transform:uppercase;" />
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">
                            Kart Numarası
                        </label>
                        <input name="KartNumarasi" class="form-control"
                               placeholder="0000 0000 0000 0000"
                               maxlength="19"
                               style="letter-spacing:2px;font-family:monospace;"
                               oninput="formatKart(this)" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" style="font-size:13px;">
                            Son Kullanma Ay
                        </label>
                        <select name="SonKullanmaAy" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i.ToString("D2")">
                                    @i.ToString("D2")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" style="font-size:13px;">
                            Son Kullanma Yıl
                        </label>
                        <select name="SonKullanmaYil" class="form-select">
                            @for (int y = DateTime.Now.Year;
                                  y <= DateTime.Now.Year + 10; y++)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" style="font-size:13px;">CVV</label>
                        <input name="Cvv" class="form-control"
                               placeholder="***" maxlength="4"
                               type="password" />
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">
                            Taksit Seçeneği
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var t in new[] { 1, 2, 3, 6, 9, 12 })
                            {
                                <label style="cursor:pointer;">
                                    <input type="radio" name="Taksit"
                                           value="@t"
                                           style="display:none;"
                                           class="taksit-radio"
                                    @(t == 1 ? "checked" : "") />
                                    <span class="taksit-btn"
                                          style="display:inline-block;
                                        padding:6px 14px;border-radius:8px;
                                        border:2px solid #e2e8f0;font-size:12px;
                                        transition:all 0.2s;cursor:pointer;
                                        background:@(t == 1 ? "#1e3a5f" : "#fff");
                                        color:@(t == 1 ? "#fff" : "#4a5568");">
                                        @(t == 1 ? "Tek Çekim" : $"{t} Taksit")
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <button type="submit" id="odemeBtn"
                                class="btn btn-auth"
                                style="width:100%;padding:14px;font-size:15px;">
                            <i class="fas fa-lock me-2"></i>
                            @payment?.KalanTutar.ToString("N2") ₺ Öde
                        </button>
                    </div>

                    <div class="col-12">
                        <p style="font-size:11px;color:#a0aec0;text-align:center;">
                            <i class="fas fa-shield-alt me-1"></i>
                            Ödeme bilgileriniz iyzico altyapısıyla güvenle işlenmektedir.
                            Kart bilgileriniz sistemimizde saklanmaz.
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Kart numarası formatla
        function formatKart(input) {
            let val = input.value.replace(/\D/g, '').substring(0, 16);
            input.value = val.replace(/(.{4})/g, '$1 ').trim();
        }

        // Taksit seçimi
        document.querySelectorAll('.taksit-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                document.querySelectorAll('.taksit-btn').forEach(btn => {
                    btn.style.background = '#fff';
                    btn.style.color = '#4a5568';
                    btn.style.borderColor = '#e2e8f0';
                });
                this.nextElementSibling.style.background = '#1e3a5f';
                this.nextElementSibling.style.color = '#fff';
                this.nextElementSibling.style.borderColor = '#1e3a5f';
            });
        });

        // Form gönderiminde loading
        document.getElementById('odemeForm').addEventListener('submit', function() {
            const btn = document.getElementById('odemeBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>İşleniyor...';
        });
    </script>
}