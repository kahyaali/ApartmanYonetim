        <nav id="sidebar">
            <div class="sidebar-header">
                <div class="building-img-wrapper">
                    <img src="~/images/bina.png"
                         alt="Apartman"
                         class="building-img"
                         onerror="this.onerror=null;this.src='https://placehold.co/280x160/1e3a5f/ffffff?text=Apartman';" />
                </div>
                <h5 class="sidebar-title">Apartman Yönetimi</h5>
                <p class="sidebar-subtitle">Hoş geldiniz</p>
            </div>

            <div class="sidebar-user">
