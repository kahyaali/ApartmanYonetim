        <div id="content">
            <nav class="top-navbar">
                <button id="sidebarToggle" class="sidebar-toggle-btn">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="top-navbar-right">
                    <!-- Pin -->
                    <button id="pinToggleBtn"
                            onclick="togglePin(document.title.split('—')[0].trim(), window.location.pathname, 'fa-bookmark', this)"
                            style="background:none;border:none;cursor:pointer;
                                   font-size:15px;color:#a0aec0;padding:5px 6px;
                                   border-radius:8px;flex-shrink:0;"
                            title="Bu sayfayı favorilere ekle">
                        <i class="fas fa-thumbtack"></i>
                    </button>

                    <!-- Dark Mode -->
                    <button id="darkModeToggle"
                            style="background:none;border:none;cursor:pointer;
                                   font-size:16px;color:#718096;padding:5px 6px;
                                   border-radius:8px;flex-shrink:0;"
                            title="Dark Mode">
                        <i id="darkModeIcon" class="fas fa-moon"></i>
                    </button>

                    <!-- Arama -->
                    <form asp-controller="Search" asp-action="Index" method="get"
                          style="flex-shrink:0;">
                        <div style="position:relative;">
                            <i class="fas fa-search"
                               style="position:absolute;left:8px;top:50%;
                                      transform:translateY(-50%);color:#a0aec0;
                                      font-size:12px;pointer-events:none;"></i>
                            <input type="text" name="q"
                                   placeholder="Ara..."
                                   style="padding:6px 10px 6px 26px;
                                          border:1px solid #e2e8f0;
                                          border-radius:20px;font-size:12px;
                                          width:130px;background:#f8fafc;
                                          outline:none;transition:width 0.2s;" 
                                   onfocus="this.style.width='200px';this.style.borderColor='#2d6a9f'"
                                   onblur="this.style.width='130px';this.style.borderColor='#e2e8f0'" />
                        </div>
                    </form>

                    <!-- Tarih — sadece geniş ekranda -->
                    <span class="d-none d-xl-inline-flex align-items-center"
                          style="font-size:12px;color:#718096;white-space:nowrap;flex-shrink:0;">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @DateTime.Now.ToString("dd MMMM yyyy",
                            new System.Globalization.CultureInfo("tr-TR"))
                    </span>
                </div>
            </nav>

            <main class="main-content">
                @Html.AntiForgeryToken()

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3"
                         style="font-size:13px;border-radius:10px;">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3"
                         style="font-size:13px;border-radius:10px;">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                } 

                @RenderBody()
            </main>

            <footer class="main-footer">
                <span>&copy; @DateTime.Now.Year Apartman Yönetim Sistemi</span>
            </footer>
        </div>
    </div>
}
else
{
    <main>@RenderBody()</main>
}

<div id="notificationContainer"
     style="position:fixed;top:70px;right:20px;z-index:9999;
            width:320px;pointer-events:none;">
</div>

<!-- Silme Modal -->
<div id="confirmModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);
            z-index:99998;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:28px;
                max-width:380px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);
                text-align:center;">
        <div style="width:56px;height:56px;border-radius:50%;background:#fdf2f2;
                     display:flex;align-items:center;justify-content:center;
                     margin:0 auto 16px;">
            <i class="fas fa-exclamation-triangle"
               style="color:#e74c3c;font-size:24px;"></i>
        </div>
        <h6 style="color:#1e3a5f;font-weight:600;margin-bottom:8px;">
            Silme Onayı
        </h6>
        <p id="confirmMessage"
           style="font-size:13px;color:#718096;margin-bottom:20px;"></p>
        <div class="d-flex gap-2 justify-content-center">
            <button id="confirmCancel"
                    style="padding:8px 20px;border:1px solid #e2e8f0;
                           border-radius:8px;background:#fff;cursor:pointer;
                           font-size:13px;">
                İptal
            </button>
            <button id="confirmOk"
                    style="padding:8px 20px;background:#e74c3c;color:#fff;
                           border:none;border-radius:8px;cursor:pointer;
                           font-size:13px;font-weight:500;">
                Evet, Sil
            </button>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

<script>
function showNotification(mesaj, tip) {
    const colors = {
        success: { bg:'#d4edda', border:'#27ae60', icon:'fa-check-circle',       text:'#155724' },
        danger:  { bg:'#ffd6d6', border:'#e74c3c', icon:'fa-exclamation-circle',  text:'#721c24' },
        warning: { bg:'#fff9c4', border:'#f39c12', icon:'fa-exclamation-triangle', text:'#856404' },
        info:    { bg:'#e8f4fd', border:'#2d6a9f', icon:'fa-info-circle',         text:'#0c5460' }
    };
    const c = colors[tip] || colors.info;
    const id = 'notif_' + Date.now();
    const div = document.createElement('div');
    div.id = id;
    div.style.cssText = `background:${c.bg};border-left:4px solid ${c.border};
        border-radius:10px;padding:14px 16px;margin-bottom:10px;
        box-shadow:0 4px 15px rgba(0,0,0,0.12);pointer-events:all;
        animation:slideIn 0.3s ease;display:flex;align-items:flex-start;gap:10px;`;
    div.innerHTML = `
        <i class="fas ${c.icon}" style="color:${c.border};margin-top:2px;font-size:15px;flex-shrink:0;"></i>
        <div style="flex:1;font-size:13px;color:${c.text};line-height:1.5;">${mesaj}</div>
        <button onclick="document.getElementById('${id}').remove()"
                style="background:none;border:none;color:${c.text};
                       cursor:pointer;font-size:16px;padding:0;line-height:1;">×</button>`;
    const container = document.getElementById('notificationContainer');
    if (container) container.appendChild(div);
    setTimeout(() => {
        const el = document.getElementById(id);
        if (el) { el.style.animation='slideOut 0.3s ease'; setTimeout(()=>el?.remove(),300); }
    }, 5000);
}

async function loadFavoriler() {
    try {
        const res = await fetch('/Favori/List');
        if (!res.ok) return;
        const data = await res.json();
        const container = document.getElementById('favoriPinler');
        const divider = document.getElementById('favoriDivider');
        if (!container) return;

        const pinBtn = document.getElementById('pinToggleBtn');
        if (pinBtn) {
            const pinli = data.some(f => f.url === window.location.pathname);
            const icon = pinBtn.querySelector('i');
            if (icon) icon.style.color = pinli ? '#f39c12' : '#a0aec0';
        }

        if (data.length === 0) {
            container.innerHTML = '';
            if (divider) divider.style.display = 'none';
            return;
        }

        if (divider) divider.style.display = 'block';
        container.innerHTML = `
            <div style="font-size:10px;color:#5a8ab0;font-weight:700;
                        letter-spacing:1.5px;padding:0 10px 6px;">
                PİNLENEN SAYFALAR
            </div>
            ${data.map(f => `
                <a href="${f.url}"
                   style="display:flex;align-items:center;gap:10px;padding:8px 10px;
                          color:#a8c8e8;text-decoration:none;font-size:13px;
                          border-radius:8px;transition:background 0.2s;"
                   onmouseover="this.style.background='rgba(255,255,255,0.08)'"
                   onmouseout="this.style.background='transparent'">
                    <i class="fas ${f.ikon}" style="width:18px;text-align:center;font-size:13px;"></i>
                    <span>${f.baslik}</span>
                </a>
            `).join('')}`;
    } catch(e) { console.warn('Favori yüklenemedi:', e); }
}

async function togglePin(baslik, url, ikon, btn) {
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const res = await fetch('/Favori/Toggle', {
            method: 'POST',
            headers: { 'Content-Type':'application/json', 'RequestVerificationToken':token },
            body: JSON.stringify({ baslik, url, ikon })
        });
        const data = await res.json();
        if (data.success) {
            const icon = btn.querySelector ? btn.querySelector('i') : btn;
            if (icon) icon.style.color = data.pinned ? '#f39c12' : '#a0aec0';
            showNotification(data.mesaj, data.pinned ? 'success' : 'info');
            loadFavoriler();
        }
    } catch(e) { console.warn('Pin hatası:', e); }
}

function showConfirm(mesaj) {
    return new Promise(resolve => {
        const modal = document.getElementById('confirmModal');
        document.getElementById('confirmMessage').textContent = mesaj;
        modal.style.display = 'flex';

        const okBtn = document.getElementById('confirmOk');
        const cancelBtn = document.getElementById('confirmCancel');

        const cleanup = () => {
            modal.style.display = 'none';
            okBtn.replaceWith(okBtn.cloneNode(true));
            cancelBtn.replaceWith(cancelBtn.cloneNode(true));
        };

        document.getElementById('confirmOk').onclick = () => { cleanup(); resolve(true); };
        document.getElementById('confirmCancel').onclick = () => { cleanup(); resolve(false); };
    });
}


      

async function mesajSayisiGuncelle() {
    try {
        const res = await fetch('/Mesaj/OkunmamisSayi');
        if (!res.ok) return;
        const data = await res.json();
        const badge = document.getElementById('mesajBadge');
        if (badge) {
            if (data.sayi > 0) {
                badge.textContent = data.sayi;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
    } catch(e) {}
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <text>
    // ── SignalR — global scope'ta tanımla ──
    let signalRConnection = null;

    function signalRBaslat() {
        if (typeof signalR === 'undefined') {
            console.warn('SignalR yüklenemedi.');
            return;
        }

        signalRConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        // Bildirim dinle
        signalRConnection.on("ReceiveNotification", function(mesaj, tip) {
            showNotification(mesaj, tip);
        });

        // Veri yenileme dinle
        signalRConnection.on("RefreshData", function(dataType) {
            if (dataType === "payments") {
                window.dispatchEvent(new CustomEvent('refreshPayments'));
            }
            if (dataType === "announcements") {
                window.dispatchEvent(new CustomEvent('refreshAnnouncements'));
            }
        });

        signalRConnection.start().then(function() {
            console.log('SignalR bağlandı.');

            @if (User.IsInRole("Admin"))
            {
                <text>
                signalRConnection.invoke("JoinGroup", "admins")
                    .catch(err => console.warn('Admin grup hatası:', err));
                </text>
            }

            var userId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
            if (userId) {
                signalRConnection.invoke("JoinGroup", "user_" + userId)
                    .then(() => console.log('Gruba katıldı: user_' + userId))
                    .catch(err => console.warn('User grup hatası:', err));
            }

        }).catch(function(err) {
            console.warn("SignalR bağlantı hatası:", err.toString());
        });
    }

    // ── DOMContentLoaded ──
    document.addEventListener('DOMContentLoaded', function() {
        loadFavoriler();
        mesajSayisiGuncelle();
        setInterval(mesajSayisiGuncelle, 30000);
        signalRBaslat();
    });

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        loadFavoriler();
    }
    </text>
}
</script>

