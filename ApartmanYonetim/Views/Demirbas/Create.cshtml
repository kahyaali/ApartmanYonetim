@model ApartmanYonetim.Models.ViewModels.DemirbasViewModel
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Yeni Demirbaş";
}

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Yeni Demirbaş Ekle</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3" style="font-size:13px;">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div><i class="fas fa-exclamation-circle me-1"></i>@error.ErrorMessage</div>
        }
    </div>
}

<div class="form-card" style="max-width:700px;">
    <form asp-action="Create" method="post"
          enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <div class="row g-3">

            <div class="col-md-8">
                <label class="form-label" style="font-size:13px;">Ad *</label>
                @* <input name="Ad" value="@Model.Ad"class="form-control" placeholder="Demirbaş adı" /> *@
                <input asp-for="Ad" class="form-control" placeholder="Demirbaş adı" />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Kategori</label>
                <select name="Kategori" class="form-select">
                    @foreach (DemirbasKategori k in Enum.GetValues(typeof(DemirbasKategori)))
                    {
                        <option value="@((int)k)"
                                selected="@(Model.Kategori == k)">@k</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Marka</label>
                <input name="Marka" value="@Model.Marka"
                       class="form-control" placeholder="Bosch, Samsung..." />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Model</label>
                <input name="Model" value="@Model.Model"
                       class="form-control" placeholder="Model adı" />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Seri No</label>
                <input name="SeriNo" value="@Model.SeriNo"
                       class="form-control" placeholder="SN-12345" />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Konum</label>
                <input name="Konum" value="@Model.Konum"
                       class="form-control" placeholder="Bodrum, Giriş..." />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Alım Tarihi</label>
                <input name="AlimTarihi" type="date"
                       value="@Model.AlimTarihi?.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Fiyat (₺)</label>
                <input name="Fiyat" type="number" step="0.01"
                       value="@Model.Fiyat"
                       class="form-control" placeholder="0.00" />
            </div>

            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Durum</label>
                <select name="Durum" class="form-select">
                    @foreach (DemirbasDurum d in Enum.GetValues(typeof(DemirbasDurum)))
                    {
                        <option value="@((int)d)"
                                selected="@(Model.Durum == d)">@d</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="3"
                          placeholder="Demirbaş hakkında notlar...">@Model.Aciklama</textarea>
            </div>

            <!-- Resim Yükleme -->
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">
                    Resimler (Opsiyonel — Çoklu seçim)
                </label>
                <div id="dropZone"
                     style="border:2px dashed #e2e8f0;border-radius:12px;
                    padding:24px;text-align:center;cursor:pointer;
                    transition:border-color 0.2s;background:#fafafa;"
                     ondragover="event.preventDefault();this.style.borderColor='#2d6a9f'"
                     ondragleave="this.style.borderColor='#e2e8f0'"
                     ondrop="handleDrop(event)"
                     onclick="document.getElementById('resimInput').click()">
                    <i class="fas fa-cloud-upload-alt"
                       style="font-size:32px;color:#a0aec0;margin-bottom:8px;display:block;"></i>
                    <div style="font-size:13px;color:#718096;">
                        Resimleri buraya sürükleyin veya tıklayın
                    </div>
                    <div style="font-size:11px;color:#a0aec0;margin-top:4px;">
                        JPG, PNG, WEBP desteklenir
                    </div>
                </div>
                <input type="file" id="resimInput" name="Resimler"
                       multiple accept=".jpg,.jpeg,.png,.webp"
                       style="display:none;"
                       onchange="previewResimler(this)" />
                <div id="resimPreview" class="d-flex flex-wrap gap-2 mt-3"></div>
            </div>

            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewResimler(input) {
            const preview = document.getElementById('resimPreview');
            preview.innerHTML = '';
            const files = Array.from(input.files);
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.style.cssText = 'position:relative;';
                    div.innerHTML = `
                        <img src="${e.target.result}"
                             style="width:80px;height:80px;object-fit:cover;
                                    border-radius:8px;border:2px solid #e2e8f0;" />
                        <div style="position:absolute;bottom:2px;left:0;right:0;
                                    text-align:center;font-size:9px;color:#fff;
                                    background:rgba(0,0,0,0.5);
                                    border-radius:0 0 6px 6px;padding:2px;">
                            ${file.name.length > 10 ? file.name.substring(0,10)+'...' : file.name}
                        </div>`;
                    preview.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
            document.getElementById('dropZone').style.borderColor =
                files.length > 0 ? '#27ae60' : '#e2e8f0';
        }

        function handleDrop(event) {
            event.preventDefault();
            document.getElementById('dropZone').style.borderColor = '#e2e8f0';
            const input = document.getElementById('resimInput');
            input.files = event.dataTransfer.files;
            previewResimler(input);
        }
    </script>
}