@model List<ApartmanYonetim.Models.Entities.Demirbas>
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Demirbaşlar";
}

<div class="page-header">
    <h4><i class="fas fa-archive me-2"></i>Demirbaşlar</h4>
    <a asp-action="Create" class="btn btn-sm"
           style="background:#1e3a5f;color:#fff;border-radius:8px;">
        <i class="fas fa-plus me-1"></i>Yeni Demirbaş
    </a>
</div>

<!-- Özet Kartlar -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#eafaf1;">
                    <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.ToplamAktif</div>
                    <div class="stat-label">Aktif</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fdf2f2;">
                    <i class="fas fa-exclamation-triangle" style="color:#e74c3c;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.ToplamArizali</div>
                    <div class="stat-label">Arızalı</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fdf6ec;">
                    <i class="fas fa-tools" style="color:#e67e22;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.ToplamBakim</div>
                    <div class="stat-label">Bakımda</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#e8f4fd;">
                    <i class="fas fa-lira-sign" style="color:#2d6a9f;"></i>
                </div>
                <div>
                    <div class="stat-number" style="font-size:18px;">
                        @ViewBag.ToplamDeger.ToString("N0") ₺
                    </div>
                    <div class="stat-label">Toplam Değer</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtreler -->
<div class="table-card mb-3">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label" style="font-size:12px;">Kategori</label>
            <select name="kategori" class="form-select form-select-sm" style="width:150px;">
                <option value="">Tümü</option>
                @foreach (DemirbasKategori k in Enum.GetValues(typeof(DemirbasKategori)))
                {
                    <option value="@((int)k)"
                            selected="@(ViewBag.SecilenKategori == k)">@k</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:12px;">Durum</label>
            <select name="durum" class="form-select form-select-sm" style="width:130px;">
                <option value="">Tümü</option>
                @foreach (DemirbasDurum d in Enum.GetValues(typeof(DemirbasDurum)))
                {
                    <option value="@((int)d)"
                            selected="@(ViewBag.SecilenDurum == d)">@d</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:12px;">Ara</label>
            <input name="ara" type="text" class="form-control form-control-sm"
                   value="@ViewBag.AramaMetni" placeholder="Ad, seri no, marka..."
                   style="width:180px;" />
        </div>
        <button type="submit" class="btn btn-sm"
                style="background:#1e3a5f;color:#fff;border-radius:8px;">
            <i class="fas fa-filter me-1"></i>Filtrele
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Temizle</a>
    </form>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table id="tblDemirbaslar" class="table table-hover align-middle"
               style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Resim</th>
                    <th>Ad</th>
                    <th>Kategori</th>
                    <th>Marka / Model</th>
                    <th>Konum</th>
                    <th>Seri No</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    var ilkResim = d.Resimler.OrderBy(r => r.SiraNo).FirstOrDefault();
                    var resimSayisi = d.Resimler.Count;

                    string durumClass = d.Durum switch
                    {
                        DemirbasDurum.Aktif => "badge bg-success",
                        DemirbasDurum.Arizali => "badge bg-danger",
                        DemirbasDurum.Bakimda => "badge bg-warning text-dark",
                        DemirbasDurum.Hurda => "badge bg-secondary",
                        _ => "badge bg-secondary"
                    };

                    <tr>
                        <td>
                            <div style="position:relative;display:inline-block;cursor:pointer;"
                                 onclick="openLightbox(@d.Id, 0)">
                                @if (ilkResim != null)
                                {
                                    <img src="@ilkResim.ResimYolu"
                                         style="width:52px;height:52px;object-fit:cover;
                                    border-radius:8px;border:2px solid #e2e8f0;" />
                                }
                                else
                                {
                                    <div style="width:52px;height:52px;border-radius:8px;
                                        background:#f0f2f5;display:flex;
                                        align-items:center;justify-content:center;
                                        border:2px solid #e2e8f0;">
                                        <i class="fas fa-image" style="color:#a0aec0;font-size:20px;"></i>
                                    </div>
                                }
                                @if (resimSayisi > 0)
                                {
                                    <span style="position:absolute;top:-6px;right:-6px;
                                        background:#1e3a5f;color:#fff;
                                        border-radius:50%;width:20px;height:20px;
                                        font-size:10px;font-weight:700;
                                        display:flex;align-items:center;
                                        justify-content:center;">
                                        @resimSayisi
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <div style="font-weight:600;">@d.Ad</div>
                            @if (!string.IsNullOrEmpty(d.Aciklama))
                            {
                                <div style="font-size:11px;color:#718096;">
                                    @d.Aciklama.Substring(0, Math.Min(d.Aciklama.Length, 40))
                                    @(d.Aciklama.Length > 40 ? "..." : "")
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge"
                                  style="background:#e8f4fd;color:#2d6a9f;font-size:11px;">
                                @d.Kategori
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(d.Marka))
                            {
                                <div>@d.Marka</div>
                                <div style="font-size:11px;color:#718096;">@d.Model</div>
                            }
                            else
                            {

                                <span style="color:#a0aec0;">—</span>
                            }
                        </td>
                        <td>@(d.Konum ?? "—")</td>
                        <td style="font-size:12px;color:#718096;">@(d.SeriNo ?? "—")</td>
                        <td>
                            @if (d.Fiyat.HasValue)
                            {
                                <span style="font-weight:600;">
                                    @d.Fiyat.Value.ToString("N2") ₺
                                </span>
                            }
                            else
                            {

                                <span style="color:#a0aec0;">—</span>
                            }
                        </td>
                        <td>
                            <span class="@durumClass" style="font-size:11px;">@d.Durum</span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   style="font-size:11px;">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@d.Id"
                                  method="post" class="d-inline">
                                <button type="button"
                                        onclick="demirbasSil(@d.Id, '@d.Ad')"
                                        class="btn btn-sm btn-outline-danger"
                                        style="font-size:11px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Lightbox Modal -->
<div id="lightboxModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.9);
    z-index:99999;align-items:center;justify-content:center;">
    <button onclick="closeLightbox()"
            style="position:absolute;top:20px;right:20px;background:none;
        border:none;color:#fff;font-size:32px;cursor:pointer;
        z-index:100001;">
        ×
    </button>

    <button onclick="prevResim()"
            style="position:absolute;left:20px;background:rgba(255,255,255,0.2);
        border:none;color:#fff;font-size:28px;cursor:pointer;
        padding:10px 16px;border-radius:8px;z-index:100001;">
        ‹
    </button>

    <button onclick="nextResim()"
            style="position:absolute;right:20px;background:rgba(255,255,255,0.2);
        border:none;color:#fff;font-size:28px;cursor:pointer;
        padding:10px 16px;border-radius:8px;z-index:100001;">
        ›
    </button>

    <div style="text-align:center;max-width:90vw;max-height:90vh;">
        <img id="lightboxImg"
             style="max-width:90vw;max-height:80vh;object-fit:contain;
        border-radius:12px;" src="" alt="" />
        <div id="lightboxKaption"
             style="color:#fff;font-size:13px;margin-top:12px;"></div>
        <div id="lightboxSayac"
             style="color:#a0aec0;font-size:12px;margin-top:6px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        let lightboxResimler = [];
        let lightboxIndex = 0;

        async function openLightbox(demirbasId, startIndex) {
            try {
                const res = await fetch(`/Demirbase/GetResimler/${demirbasId}`);
                const data = await res.json();

                if (!data || data.length === 0) return;

                lightboxResimler = data;
                lightboxIndex = startIndex;
                showLightboxResim();

                const modal = document.getElementById('lightboxModal');
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            } catch(e) {
                console.warn('Lightbox hatası:', e);
            }
        }

        function showLightboxResim() {
            const resim = lightboxResimler[lightboxIndex];
            document.getElementById('lightboxImg').src = resim.resimYolu;
            document.getElementById('lightboxKaption').textContent = resim.aciklama || '';
            document.getElementById('lightboxSayac').textContent =
                `${lightboxIndex + 1} / ${lightboxResimler.length}`;
        }

        function prevResim() {
            lightboxIndex = (lightboxIndex - 1 + lightboxResimler.length)
                % lightboxResimler.length;
            showLightboxResim();
        }

        function nextResim() {
            lightboxIndex = (lightboxIndex + 1) % lightboxResimler.length;
            showLightboxResim();
        }

        function closeLightbox() {
            document.getElementById('lightboxModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        // Klavye desteği
        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('lightboxModal');
            if (modal.style.display === 'none') return;
            if (e.key === 'ArrowLeft') prevResim();
            if (e.key === 'ArrowRight') nextResim();
            if (e.key === 'Escape') closeLightbox();
        });

        // Arka plana tıklayınca kapat
        document.getElementById('lightboxModal').addEventListener('click', function(e) {
            if (e.target === this) closeLightbox();
        });

        $(document).ready(function() {
            $('#tblDemirbaslar').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json' },
                pageLength: 15
            });
        });
                // Demirbaş silme onayı
        function demirbasSil(id, ad) {
            showConfirm(`"${ad}" demirbaşını silmek istediğinize emin misiniz?`)
                .then(onay => {
                    if (!onay) return;
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = `/Demirbas/Delete/${id}`;
                    const token = document.querySelector(
                        'input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        const inp = document.createElement('input');
                        inp.type = 'hidden';
                        inp.name = '__RequestVerificationToken';
                        inp.value = token;
                        form.appendChild(inp);
                    }
                    document.body.appendChild(form);
                    form.submit();
                });
        }
    </script>
}