@model ApartmanYonetim.Models.ViewModels.AidatTanimiViewModel
@{
    ViewData["Title"] = "Aidat Tanımla";
}


<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Yeni Aidat Tanımla</h4>
    
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3" style="font-size:13px;">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div><i class="fas fa-exclamation-circle me-1"></i>@error.ErrorMessage</div>
        }
    </div>
}

<div class="form-card" style="max-width:560px;">
    <div class="alert mb-4" style="background:#e8f4fd;border:none;border-radius:10px;font-size:13px;">
        <i class="fas fa-info-circle me-2" style="color:#2d6a9f;"></i>
        Aidat tanımladığınızda sistem <strong>tüm dolu dairelere</strong> otomatik olarak
        ödeme kaydı oluşturur. Sakinler kendi panellerinden görebilir.
    </div>

    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Aidat Türü</label>
                <select asp-for="Baslik" class="form-select">
                    <option value="">Seçiniz</option>
                    <option value="Aylık Aidat">Aylık Aidat</option>
                    <option value="Su">Su</option>
                    <option value="Doğalgaz">Doğalgaz</option>
                    <option value="Elektrik">Elektrik (Ortak Alan)</option>
                    <option value="Asansör Bakım">Asansör Bakım</option>
                    <option value="Temizlik">Temizlik</option>
                    <option value="Diğer">Diğer</option>
                </select>
                <span asp-validation-for="Baslik" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Tutar (₺)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light" style="font-size:13px;">₺</span>
                    <input asp-for="Tutar" class="form-control" type="number"
                           step="0.01" placeholder="0.00" />
                </div>
                <span asp-validation-for="Tutar" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label" style="font-size:13px;">Ay</label>
                <select asp-for="Ay" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var ayAdi = new DateTime(2024, i, 1)
                            .ToString("MMMM", new System.Globalization.CultureInfo("tr-TR"));
                        <option value="@i">@ayAdi</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label" style="font-size:13px;">Yıl</label>
                <select asp-for="Yil" class="form-select">
                    @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Son Ödeme Tarihi</label>
                <input asp-for="SonOdemeTarihi" class="form-control" type="date" />
                <span asp-validation-for="SonOdemeTarihi" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="col-12">
                <div class="form-check" style="background:#f8fafc;padding:14px;border-radius:10px;">
                    <input asp-for="TumDairelereUygula" class="form-check-input" />
                    <label class="form-check-label" style="font-size:13px;">
                        <strong>Tüm dolu dairelere otomatik uygula</strong>
                        <div style="font-size:12px;color:#718096;margin-top:2px;">
                            İşaretliyse sistem her daire için otomatik ödeme kaydı oluşturur.
                        </div>
                    </label>
                </div>
            </div>

            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
                    <i class="fas fa-file-invoice-dollar me-2"></i>Aidatı Tanımla
                </button>
            </div>
        </div>
    </form>
</div>