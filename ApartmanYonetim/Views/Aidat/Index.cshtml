@model List<ApartmanYonetim.Models.Entities.AidatTanimi>
@{
    ViewData["Title"] = "Aidat Tanımları";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-file-invoice-dollar me-2"></i>Aidat Tanımları</h4>
   
    <a asp-action="Create" class="btn btn-sm"
           style="background:#1e3a5f;color:#fff;border-radius:8px;">
        <i class="fas fa-plus me-1"></i>Yeni Aidat Tanımla
    </a>
    <button onclick="window.print()"
            class="btn btn-sm btn-outline-secondary no-print">
        <i class="fas fa-print me-1"></i>Yazdır
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="table-card text-center py-5">
        <i class="fas fa-file-invoice-dollar text-muted" style="font-size:48px;opacity:0.3;"></i>
        <p class="text-muted mt-3">Henüz aidat tanımı yapılmamış.</p>
        <a asp-action="Create" class="btn btn-sm"
               style="background:#1e3a5f;color:#fff;border-radius:8px;margin-top:8px;">
            <i class="fas fa-plus me-1"></i>İlk Aidatı Tanımla
        </a>
    </div>
}
else
{
    @foreach (var tanimla in Model.GroupBy(a => a.Yil).OrderByDescending(g => g.Key))
    {
        <div class="mb-4">
            <div style="font-size:13px;font-weight:700;color:#718096;
                letter-spacing:1px;margin-bottom:12px;">
                @tanimla.Key
            </div>
            <div class="row g-3">
                @foreach (var a in tanimla.OrderBy(x => x.Ay))
                {
                    var odenenSayi = a.Payments.Count(p => p.Odendi);
                    var toplamSayi = a.Payments.Count;
                    var oran = toplamSayi > 0 ? (int)((double)odenenSayi / toplamSayi * 100) : 0;
                    var ayAdi = new DateTime(a.Yil, a.Ay, 1)
                        .ToString("MMMM", new System.Globalization.CultureInfo("tr-TR"));

                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <div>
                                    <div style="font-size:16px;font-weight:700;color:#1e3a5f;">
                                        @a.Baslik
                                    </div>
                                    <div style="font-size:12px;color:#718096;">
                                        @ayAdi @a.Yil
                                    </div>
                                </div>
                                <div style="font-size:18px;font-weight:700;color:#27ae60;">
                                    @a.Tutar.ToString("N0") ₺
                                </div>
                            </div>

                            <div style="font-size:12px;color:#718096;margin-bottom:6px;">
                                Son ödeme: @a.SonOdemeTarihi.ToString("dd.MM.yyyy")
                            </div>

                            <!-- Tahsilat bar -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between mb-1"
                                     style="font-size:11px;color:#a0aec0;">
                                    <span>Tahsilat</span>
                                    <span>@odenenSayi / @toplamSayi ödendi</span>
                                </div>
                                <div style="background:#e2e8f0;border-radius:20px;height:6px;">
                                    <div style="width:@oran%;background:#27ae60;
                                        border-radius:20px;height:6px;">
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <a asp-action="Detail" asp-route-id="@a.Id"
                                       class="btn btn-sm flex-grow-1"
                                       style="background:#e8f4fd;color:#2d6a9f;
                                    border-radius:8px;font-size:12px;">
                                    <i class="fas fa-list me-1"></i>Detay
                                </a>
                                <form asp-action="Delete" asp-route-id="@a.Id"
                                      method="post" class="d-inline">                             

                                    <button type="button"
                                            onclick="aidatSil(@a.Id,'@a.Baslik')"
                                            class="btn btn-sm btn-outline-danger"
                                            style="font-size:11px;">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}


@section Scripts {
    <script>

function aidatSil(id,ad) {
showConfirm(`"${ad}"  silmek istediğinize emin misiniz?`)
.then(onay => {
if (!onay) return;
const form = document.createElement('form');
form.method = 'POST';
form.action = `/Aidat/Delete/${id}`;
const token = document.querySelector(
'input[name="__RequestVerificationToken"]')?.value;
if (token) {
const inp = document.createElement('input');
inp.type = 'hidden';
inp.name = '__RequestVerificationToken';
inp.value = token;
form.appendChild(inp);
}
document.body.appendChild(form);
form.submit();
});
}
    </script>
}