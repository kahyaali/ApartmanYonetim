@model ApartmanYonetim.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profilim";
    var profilFoto = (string?)ViewBag.ProfilFoto;
}


<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-user me-2"></i>Profilim</h4>
  
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="table-card mb-4">
    <div class="d-flex align-items-center gap-4">
        <!-- Profil Fotoğrafı -->
        <div style="position:relative;">
            @if (!string.IsNullOrEmpty(profilFoto))
            {
                <img src="@profilFoto"
                     style="width:100px;height:100px;border-radius:50%;
                object-fit:cover;border:3px solid #e2e8f0;" />
            }
            else
            {
                <div style="width:100px;height:100px;border-radius:50%;
                    background:#e8f4fd;display:flex;
                    align-items:center;justify-content:center;
                    border:3px solid #e2e8f0;">
                    <i class="fas fa-user-circle"
                       style="font-size:60px;color:#2d6a9f;"></i>
                </div>
            }
        </div>

        <div class="flex-grow-1">
            <h5 style="font-weight:600;color:#1e3a5f;margin-bottom:4px;">
                @ViewBag.AdSoyad
            </h5>
            <div style="font-size:13px;color:#718096;margin-bottom:12px;">
                @ViewBag.Email
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <!-- Fotoğraf Yükle -->
                <form asp-action="FotoYukle" method="post"
                      enctype="multipart/form-data" class="d-inline">
                    <label style="cursor:pointer;">
                        <input type="file" name="foto"
                               accept=".jpg,.jpeg,.png,.webp"
                               style="display:none;"
                               onchange="this.form.submit()" />
                        <span class="btn btn-sm btn-outline-primary"
                              style="font-size:12px;">
                            <i class="fas fa-camera me-1"></i>
                            Fotoğraf Değiştir
                        </span>
                    </label>
                </form>

                @if (!string.IsNullOrEmpty(profilFoto))
                {
                    <form asp-action="FotoSil" method="post" class="d-inline">
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                style="font-size:12px;"
                                onclick="return confirm('Fotoğrafı kaldırmak istediğinize emin misiniz?')">
                            <i class="fas fa-trash me-1"></i>Kaldır
                        </button>
                    </form>
                }
            </div>
            <div style="font-size:11px;color:#a0aec0;margin-top:6px;">
                JPG, PNG, WEBP — Maks. 5MB
            </div>
        </div>
    </div>
</div>


<!-- Profil kartı -->
<div class="row g-4">
    <!-- Profil Kartı -->
    <div class="col-md-4">
        <div class="table-card text-center">
            <div style="width:90px;height:90px;border-radius:50%;background:#e8f4fd;
                display:flex;align-items:center;justify-content:center;
                margin:0 auto 16px;font-size:36px;color:#2d6a9f;">
                <i class="fas fa-user-circle"></i>
            </div>
            <h5 style="color:#1e3a5f;font-weight:600;">@Model.Ad @Model.Soyad</h5>
            <p style="color:#718096;font-size:13px;">@Model.Email</p>

            @if (Model.Rol == "Admin")
            {
                <span class="badge" style="background:#fdf2f2;color:#e74c3c;
                    font-size:12px;padding:6px 16px;">
                    <i class="fas fa-shield-alt me-1"></i>Yönetici
                </span>
            }
            else
            {
                <span class="badge" style="background:#eafaf1;color:#27ae60;
                    font-size:12px;padding:6px 16px;">
                    <i class="fas fa-home me-1"></i>
                    @(Model.DaireNo.HasValue ? $"Daire {Model.DaireNo}" : "Sakin")
                </span>
            }

            <hr class="my-3" />

            <div class="d-grid gap-2">
                <a asp-action="Edit"
                       class="btn btn-sm"
                       style="background:#1e3a5f;color:#fff;border-radius:8px;">
                    <i class="fas fa-edit me-2"></i>Profili Düzenle
                </a>
                <a asp-action="ChangePassword"
                       class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-lock me-2"></i>Şifre Değiştir
                </a>
            </div>
        </div>
    </div>

    <!-- Bilgi Kartı -->
    <div class="col-md-8">
        <div class="table-card">
            <h6 class="mb-4 fw-600" style="color:#1e3a5f;">
                <i class="fas fa-info-circle me-2"></i>Hesap Bilgileri
            </h6>

            <div class="row g-3">
                <div class="col-md-6">
                    <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                        <div style="font-size:11px;color:#a0aec0;text-transform:uppercase;
                            letter-spacing:1px;margin-bottom:4px;">
                            Ad
                        </div>
                        <div style="font-size:15px;font-weight:600;color:#2d3748;">@Model.Ad</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                        <div style="font-size:11px;color:#a0aec0;text-transform:uppercase;
                            letter-spacing:1px;margin-bottom:4px;">
                            Soyad
                        </div>
                        <div style="font-size:15px;font-weight:600;color:#2d3748;">@Model.Soyad</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                        <div style="font-size:11px;color:#a0aec0;text-transform:uppercase;
                            letter-spacing:1px;margin-bottom:4px;">
                            E-posta
                        </div>
                        <div style="font-size:15px;font-weight:600;color:#2d3748;">@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                        <div style="font-size:11px;color:#a0aec0;text-transform:uppercase;
                            letter-spacing:1px;margin-bottom:4px;">
                            Daire
                        </div>
                        <div style="font-size:15px;font-weight:600;color:#2d3748;">
                            @(Model.DaireNo.HasValue ? $"Daire {Model.DaireNo}" : "—")
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="background:#f8fafc;border-radius:10px;padding:16px;">
                        <div style="font-size:11px;color:#a0aec0;text-transform:uppercase;
                            letter-spacing:1px;margin-bottom:4px;">
                            Rol
                        </div>
                        <div style="font-size:15px;font-weight:600;color:#2d3748;">@Model.Rol</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>