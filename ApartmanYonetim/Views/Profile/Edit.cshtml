@model ApartmanYonetim.Models.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "Profil Düzenle";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-user-edit me-2"></i>Profil Düzenle</h4>
    
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Ad</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Soyad</label>
                <input asp-for="Soyad" class="form-control" />
                <span asp-validation-for="Soyad" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">E-posta</label>
                <input asp-for="Email" class="form-control" disabled />
                <small class="text-muted" style="font-size:12px;">
                    E-posta adresi değiştirilemez.
                </small>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </form>
</div>