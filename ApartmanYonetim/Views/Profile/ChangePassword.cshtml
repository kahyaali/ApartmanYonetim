@model ApartmanYonetim.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-lock me-2"></i>Şifre Değiştir</h4>
    
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-3" style="font-size:13px;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="ChangePassword" method="post">
        <div class="mb-3">
            <label class="form-label" style="font-size:13px;">Mevcut Şifre</label>
            <input asp-for="EskiSifre" class="form-control" placeholder="Mevcut şifreniz" />
            <span asp-validation-for="EskiSifre" class="text-danger" style="font-size:12px;"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" style="font-size:13px;">Yeni Şifre</label>
            <input asp-for="YeniSifre" class="form-control" placeholder="En az 6 karakter" />
            <span asp-validation-for="YeniSifre" class="text-danger" style="font-size:12px;"></span>
        </div>
        <div class="mb-4">
            <label class="form-label" style="font-size:13px;">Yeni Şifre Tekrar</label>
            <input asp-for="YeniSifreTekrar" class="form-control" placeholder="Şifreyi tekrar girin" />
            <span asp-validation-for="YeniSifreTekrar" class="text-danger" style="font-size:12px;"></span>
        </div>
        <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
            <i class="fas fa-save me-2"></i>Şifreyi Güncelle
        </button>
    </form>
</div>