@model List<ApartmanYonetim.Models.Entities.YoneticiBlock>
@{
    ViewData["Title"] = "Yönetici Blok Atamaları";
}

<div class="page-header">
    <h4><i class="fas fa-user-shield me-2"></i>Yönetici Blok Atamaları</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3"
         style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"
         style="font-size:13px;">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Yeni Atama -->
<div class="table-card mb-4">
    <h6 class="mb-3" style="font-weight:600;color:#1e3a5f;">
        <i class="fas fa-plus me-2"></i>Yeni Atama
    </h6>
    <form asp-action="Ata" method="post">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label" style="font-size:13px;">Yönetici</label>
                <select name="yoneticiId" class="form-select">
                    <option value="">Yönetici Seçiniz</option>
                    @if (ViewBag.Yoneticiler != null)
                    {
                        @foreach (ApartmanYonetim.Models.Entities.AppUser u
                            in ViewBag.Yoneticiler)
                        {
                            <option value="@u.Id">
                                @u.Ad @u.Soyad (@u.Email)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" style="font-size:13px;">Blok</label>
                <select name="blockId" class="form-select">
                    <option value="">Blok Seçiniz</option>
                    @if (ViewBag.Bloklar != null)
                    {
                        @foreach (ApartmanYonetim.Models.Entities.Block b
                            in ViewBag.Bloklar)
                        {
                            <option value="@b.Id">@b.Ad</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-auth"
                        style="width:100%;padding:10px;">
                    <i class="fas fa-save me-1"></i>Ata
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Mevcut Atamalar -->
<div class="table-card">
    <h6 class="mb-3" style="font-weight:600;color:#1e3a5f;">
        <i class="fas fa-list me-2"></i>Mevcut Atamalar
    </h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Yönetici</th>
                    <th>E-posta</th>
                    <th>Blok</th>
                    <th>Atama Tarihi</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">
                                @a.Yonetici?.Ad @a.Yonetici?.Soyad
                            </div>
                        </td>
                        <td style="font-size:12px;color:#718096;">
                            @a.Yonetici?.Email
                        </td>
                        <td>
                            <span class="badge"
                                  style="background:#e8f4fd;color:#2d6a9f;">
                                @a.Block?.Ad
                            </span>
                        </td>
                        <td>@a.AtamaTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            <form asp-action="AtamaKaldir"
                                  asp-route-id="@a.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Atamayı kaldırmak istediğinize emin misiniz?')">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        style="font-size:11px;">
                                    <i class="fas fa-times me-1"></i>Kaldır
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">
                            Henüz atama yapılmamış.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>