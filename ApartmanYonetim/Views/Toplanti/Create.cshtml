@model ApartmanYonetim.Models.ViewModels.ToplantiViewModel
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Yeni Toplantı";
}

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Yeni Toplantı Oluştur</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card" style="max-width:640px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Başlık *</label>
                <input name="Baslik" value="@Model.Baslik"
                       class="form-control" placeholder="Toplantı başlığı" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Tarih & Saat *
                </label>
                <input name="Tarih" type="datetime-local"
                       value="@Model.Tarih.ToString("yyyy-MM-ddTHH:mm")"
                       class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Konum</label>
                <input name="Konum" value="@Model.Konum"
                       class="form-control"
                       placeholder="Örn: Toplantı Salonu, Çatı Katı..." />
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="3"
                          placeholder="Toplantı hakkında bilgi...">@Model.Aciklama</textarea>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Notlar</label>
                <textarea name="Notlar" class="form-control" rows="2"
                          placeholder="Gündem, notlar...">@Model.Notlar</textarea>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Oluştur
                </button>
            </div>
        </div>
    </form>
</div>