@model ApartmanYonetim.Models.Entities.BakimGorev
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Bakım Görevi Düzenle";
}

<div class="page-header">
    <h4><i class="fas fa-edit me-2"></i>Bakım Görevi Düzenle</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card" style="max-width:640px;">
    <form asp-action="Duzenle" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Başlık *</label>
                <input name="Baslik" value="@Model.Baslik"
                       class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Kategori</label>
                <select name="Kategori" class="form-select">
                    @foreach (var k in new[] { "Asansör","Çatı","Elektrik",
                        "Su Tesisatı","Isıtma","Bahçe","Güvenlik",
                        "Temizlik","Boya/Badana","Diğer" })
                    {
                        <option value="@k"
                                selected="@(Model.Kategori == k)">@k</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Periyot</label>
                <select name="Periyot" class="form-select">
                    @foreach (BakimPeriyot p in
                        Enum.GetValues(typeof(BakimPeriyot)))
                    {
                        <option value="@((int)p)"
                                selected="@(Model.Periyot == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Durum</label>
                <select name="Durum" class="form-select">
                    @foreach (BakimDurum d in
                        Enum.GetValues(typeof(BakimDurum)))
                    {
                        <option value="@((int)d)"
                                selected="@(Model.Durum == d)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Planlanan Tarih *
                </label>
                <input name="PlanlananTarih" type="date"
                       value="@Model.PlanlananTarih.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Bağlı Demirbaş (Opsiyonel)
                </label>
                <select name="DemirbasId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item
                        in ViewBag.Demirbaslar)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == Model.DemirbasId?.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Firma</label>
                <input name="Firma" value="@Model.Firma"
                       class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Maliyet (₺)
                </label>
                <input name="Maliyet" type="number" step="0.01"
                       value="@Model.Maliyet"
                       class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <textarea name="Aciklama" class="form-control"
                          rows="3">@Model.Aciklama</textarea>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Notlar</label>
                <textarea name="Notlar" class="form-control"
                          rows="2">@Model.Notlar</textarea>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </form>
</div>