@model ApartmanYonetim.Models.Entities.BakimGorev
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Bakım Görevi Ekle";
}

<div class="page-header">
    <h4><i class="fas fa-plus me-2"></i>Bakım Görevi Ekle</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card" style="max-width:640px;">
    <form asp-action="Ekle" method="post">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Başlık *</label>
                <input name="Baslik" value="@Model.Baslik"
                       class="form-control"
                       placeholder="Asansör bakımı, Çatı kontrolü..." />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Kategori</label>
                <select name="Kategori" class="form-select">
                    <option value="Asansör">Asansör</option>
                    <option value="Çatı">Çatı</option>
                    <option value="Elektrik">Elektrik</option>
                    <option value="Su Tesisatı">Su Tesisatı</option>
                    <option value="Isıtma">Isıtma</option>
                    <option value="Bahçe">Bahçe</option>
                    <option value="Güvenlik">Güvenlik</option>
                    <option value="Temizlik">Temizlik</option>
                    <option value="Boya/Badana">Boya/Badana</option>
                    <option value="Diğer">Diğer</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Periyot</label>
                <select name="Periyot" class="form-select">
                    @foreach (BakimPeriyot p in
                        Enum.GetValues(typeof(BakimPeriyot)))
                    {
                        <option value="@((int)p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Planlanan Tarih *
                </label>
                <input name="PlanlananTarih" type="date"
                       value="@Model.PlanlananTarih.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Bağlı Demirbaş (Opsiyonel)
                </label>
                <select name="DemirbasId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem item
                        in ViewBag.Demirbaslar)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Firma</label>
                <input name="Firma" value="@Model.Firma"
                       class="form-control" placeholder="Bakım firması" />
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">
                    Tahmini Maliyet (₺)
                </label>
                <input name="Maliyet" type="number" step="0.01"
                       value="@Model.Maliyet"
                       class="form-control" placeholder="0.00" />
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <textarea name="Aciklama" class="form-control" rows="3"
                          placeholder="Bakım detayları...">@Model.Aciklama</textarea>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </form>
</div>