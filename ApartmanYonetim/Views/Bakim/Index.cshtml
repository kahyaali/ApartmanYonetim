@model List<ApartmanYonetim.Models.Entities.BakimGorev>
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Bakım Takvimi";
}

<div class="page-header">
    <h4><i class="fas fa-tools me-2"></i>Bakım Takvimi</h4>
    <div class="d-flex gap-2">
        <button onclick="window.print()"
                class="btn btn-sm btn-outline-secondary no-print">
            <i class="fas fa-print me-1"></i>Yazdır
        </button>
        <a asp-action="Ekle" class="btn btn-sm"
               style="background:#1e3a5f;color:#fff;border-radius:8px;">
            <i class="fas fa-plus me-1"></i>Görev Ekle
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fdf2f2;">
                    <i class="fas fa-exclamation-circle" style="color:#e74c3c;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.Gecmis</div>
                    <div class="stat-label">Gecikmiş</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fdf6ec;">
                    <i class="fas fa-calendar-week" style="color:#e67e22;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.BuHafta</div>
                    <div class="stat-label">Bu Hafta</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#e8f4fd;">
                    <i class="fas fa-list-check" style="color:#2d6a9f;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.Bekleyen</div>
                    <div class="stat-label">Toplam Bekleyen</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#eafaf1;">
                    <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.Tamamlanan</div>
                    <div class="stat-label">Tamamlanan</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtreler -->
<div class="table-card mb-3">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label" style="font-size:12px;">Durum</label>
            <select name="durum" class="form-select form-select-sm"
                    style="width:150px;">
                <option value="">Tümü</option>
                @foreach (BakimDurum d in Enum.GetValues(typeof(BakimDurum)))
                {
                    <option value="@((int)d)"
                            selected="@(ViewBag.SecilenDurum == d)">@d</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" style="font-size:12px;">Kategori</label>
            <select name="kategori" class="form-select form-select-sm"
                    style="width:160px;">
                <option value="">Tümü</option>
                @if (ViewBag.Kategoriler != null)
                {
                    @foreach (string k in ViewBag.Kategoriler)
                    {
                        <option value="@k"
                                selected="@(ViewBag.SecilenKategori == k)">
                            @k
                        </option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-sm"
                style="background:#1e3a5f;color:#fff;border-radius:8px;">
            <i class="fas fa-filter me-1"></i>Filtrele
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            Temizle
        </a>
    </form>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table id="tblBakim" class="table table-hover align-middle"
               style="font-size:13px;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th>Görev</th>
                    <th>Kategori</th>
                    <th>Periyot</th>
                    <th>Planlanan Tarih</th>
                    <th>Tamamlanma</th>
                    <th>Firma</th>
                    <th>Maliyet</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var bugun = DateTime.Today;
                    var gecmis = b.Durum == BakimDurum.Bekliyor &&
                                 b.PlanlananTarih.Date < bugun;
                    var yakin = b.Durum == BakimDurum.Bekliyor &&
                                b.PlanlananTarih.Date >= bugun &&
                                b.PlanlananTarih.Date <= bugun.AddDays(3);

                    string rowClass = gecmis ? "row-kirmizi"
                                    : yakin ? "row-sari" : "";

                    string durumClass = b.Durum switch
                    {
                        BakimDurum.Bekliyor => "badge bg-warning text-dark",
                        BakimDurum.Devam => "badge bg-info text-dark",
                        BakimDurum.Tamamlandi => "badge bg-success",
                        BakimDurum.Iptal => "badge bg-secondary",
                        _ => "badge bg-secondary"
                    };

                    <tr class="@rowClass">
                        <td>
                            <div style="font-weight:600;">@b.Baslik</div>
                            @if (!string.IsNullOrEmpty(b.Aciklama))
                            {
                                <div style="font-size:11px;color:#718096;">
                                    @b.Aciklama.Substring(0,
                                        Math.Min(b.Aciklama.Length, 50))
                                    @(b.Aciklama.Length > 50 ? "..." : "")
                                </div>
                            }
                            @if (b.Demirbas != null)
                            {
                                <div style="font-size:11px;color:#2d6a9f;">
                                    <i class="fas fa-archive me-1"></i>
                                    @b.Demirbas.Ad
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge"
                                  style="background:#e8f4fd;color:#2d6a9f;
                                font-size:11px;">
                                @b.Kategori
                            </span>
                        </td>
                        <td style="font-size:12px;">@b.Periyot</td>
                        <td>
                            <div>@b.PlanlananTarih.ToString("dd.MM.yyyy")</div>
                            @if (gecmis)
                            {
                                <div style="font-size:11px;color:#e74c3c;">
                                    @((bugun - b.PlanlananTarih.Date).Days) gün gecikti
                                </div>
                            }
                        </td>
                        <td>
                            @(b.TamamlanmaTarihi.HasValue
                                ? b.TamamlanmaTarihi.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </td>
                        <td style="font-size:12px;">@(b.Firma ?? "—")</td>
                        <td>
                            @if (b.Maliyet.HasValue)
                            {
                                <span style="font-weight:600;">
                                    @b.Maliyet.Value.ToString("N2") ₺
                                </span>
                            }
                            else
                            {

                                <span style="color:#a0aec0;">—</span>
                            }
                        </td>
                        <td>
                            <span class="@durumClass" style="font-size:11px;">
                                @b.Durum
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                @if (b.Durum == BakimDurum.Bekliyor ||
                                     b.Durum == BakimDurum.Devam)
                                {
                                    <form asp-action="Tamamla"
                                          asp-route-id="@b.Id" method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                style="font-size:11px;"
                                                title="Tamamla">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Duzenle" asp-route-id="@b.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       style="font-size:11px;" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button"
                                        onclick="bakimSil(@b.Id, '@b.Baslik')"
                                        class="btn btn-sm btn-outline-danger"
                                        style="font-size:11px;" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </button>
                                <form id="bakimSilForm_@b.Id"
                                      asp-action="Sil" asp-route-id="@b.Id"
                                      method="post" style="display:none;"></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function bakimSil(id, baslik) {
            showConfirm(`"${baslik}" bakım görevini silmek istediğinize emin misiniz?`)
                .then(onay => {
                    if (onay)
                        document.getElementById(`bakimSilForm_${id}`).submit();
                });
        }
        $(document).ready(function() {
            $('#tblBakim').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json' },
                pageLength: 15,
                order: [[3, 'asc']]
            });
        });
    </script>
}