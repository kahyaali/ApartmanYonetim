@model ApartmanYonetim.Models.ViewModels.ExpenseViewModel
@{
    ViewData["Title"] = "Gider Düzenle";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-edit me-2"></i>Gider Düzenle</h4>
   
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Firma Adı</label>
                <input asp-for="FirmaAdi" class="form-control" />
                <span asp-validation-for="FirmaAdi" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Çalışma Türü</label>
                <select asp-for="CalismaTuru" class="form-select">
                    <option value="Asansör Bakım">Asansör Bakım</option>
                    <option value="Elektrik">Elektrik</option>
                    <option value="Su / Tesisat">Su / Tesisat</option>
                    <option value="Çatı Onarım">Çatı Onarım</option>
                    <option value="Boya / Badana">Boya / Badana</option>
                    <option value="Temizlik">Temizlik</option>
                    <option value="Bahçe Bakım">Bahçe Bakım</option>
                    <option value="Güvenlik">Güvenlik</option>
                    <option value="Diğer">Diğer</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Tutar (₺)</label>
                <input asp-for="Tutar" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Gider Tarihi</label>
                <input asp-for="GiderTarihi" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Fatura No</label>
                <input asp-for="FaturaNo" class="form-control" />
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </form>
</div>