@model ApartmanYonetim.Models.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Şifremi Unuttum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fas fa-key"></i>
                <h4>Şifremi Unuttum</h4>
            </div>

            @if (ViewBag.Message == "success")
            {
                <div class="alert alert-success text-center" style="font-size:13px;">
                    <i class="fas fa-check-circle me-2"></i>
                    Şifre sıfırlama linki e-posta adresinize gönderildi.
                </div>
            }
            else
            {
                <p class="text-muted mb-4" style="font-size:13px;">
                    Kayıtlı e-posta adresinizi girin, şifre sıfırlama bağlantısı gönderelim.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label" style="font-size:13px;">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope text-muted" style="font-size:13px;"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="ornek@mail.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <button type="submit" class="btn btn-auth">
                        <i class="fas fa-paper-plane me-2"></i>Link Gönder
                    </button>
                </form>
            }

            <p class="text-center mt-4 mb-0" style="font-size:13px;">
                <a asp-action="SignIn" style="color:#1e3a5f;">
                    <i class="fas fa-arrow-left me-1"></i>Giriş sayfasına dön
                </a>
            </p>
        </div>
    </div>
</body>
</html>