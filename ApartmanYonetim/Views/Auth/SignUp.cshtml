@model ApartmanYonetim.Models.ViewModels.SignUpViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card" style="max-width:460px;">
            <div class="auth-logo">
                <i class="fas fa-building"></i>
                <h4>Apartman Yönetimi</h4>
                <p class="text-muted" style="font-size:13px;">Yeni hesap oluşturun</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3" style="font-size:13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }
            <div class="alert mb-4"
                 style="background:#e8f4fd;border:none;border-radius:10px;font-size:13px;">
                <i class="fas fa-info-circle me-2" style="color:#2d6a9f;"></i>
                Kayıt olabilmek için <strong>yönetici tarafından sisteme eklenmiş</strong>
                bir sakin olmanız gerekmektedir. Ad, soyad ve daire numaranız
                sistemdeki bilgilerle eşleşmelidir.
            </div>
            <form asp-action="SignUp" method="post">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" style="font-size:13px;">Ad</label>
                        <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                        <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label" style="font-size:13px;">Soyad</label>
                        <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                        <span asp-validation-for="Soyad" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope text-muted" style="font-size:13px;"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="ornek@mail.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">Daire No</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-door-open text-muted" style="font-size:13px;"></i>
                            </span>
                            <input asp-for="DaireNo" class="form-control border-start-0" placeholder="Örn: 5" type="number" />
                        </div>
                        <span asp-validation-for="DaireNo" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock text-muted" style="font-size:13px;"></i>
                            </span>
                            <input asp-for="Password" class="form-control border-start-0" placeholder="En az 6 karakter" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label" style="font-size:13px;">Şifre Tekrar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-lock text-muted" style="font-size:13px;"></i>
                            </span>
                            <input asp-for="PasswordConfirm" class="form-control border-start-0" placeholder="Şifrenizi tekrar girin" />
                        </div>
                        <span asp-validation-for="PasswordConfirm" class="text-danger" style="font-size:12px;"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-auth">
                            <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                        </button>
                    </div>
                </div>
            </form>

            <p class="text-center mt-4 mb-0" style="font-size:13px;color:#718096;">
                Zaten hesabınız var mı?
                <a asp-action="SignIn" style="color:#1e3a5f;font-weight:600;">Giriş Yap</a>
            </p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>