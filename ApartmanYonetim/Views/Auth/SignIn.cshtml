@model ApartmanYonetim.Models.ViewModels.SignInViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fas fa-building"></i>
                <h4>Apartman Yönetimi</h4>
                <p class="text-muted" style="font-size:13px;">Hesabınıza giriş yapın</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3" style="font-size:13px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 mb-3" style="font-size:13px;">@TempData["Success"]</div>
            }

            <form asp-action="SignIn" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label class="form-label fw-500" style="font-size:13px;">E-posta</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-envelope text-muted" style="font-size:13px;"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-start-0"
                               placeholder="ornek@mail.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-500" style="font-size:13px;">Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-lock text-muted" style="font-size:13px;"></i>
                        </span>
                        <input asp-for="Password" class="form-control border-start-0"
                               placeholder="••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label class="form-check-label" style="font-size:13px;">Beni hatırla</label>
                    </div>
                    <a asp-action="ForgotPassword" style="font-size:13px;color:#1e3a5f;">Şifremi Unuttum</a>
                </div>

                <button type="submit" class="btn btn-auth">
                    <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                </button>
            </form>

            <p class="text-center mt-4 mb-0" style="font-size:13px;color:#718096;">
                Hesabınız yok mu?
                <a asp-action="SignUp" style="color:#1e3a5f;font-weight:600;">Kayıt Ol</a>
            </p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>