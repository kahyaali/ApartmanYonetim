@model ApartmanYonetim.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Şifre Sıfırla</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fas fa-lock"></i>
                <h4>Yeni Şifre Belirle</h4>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">Yeni Şifre</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="font-size:13px;">Şifre Tekrar</label>
                    <input asp-for="NewPasswordConfirm" class="form-control" placeholder="Şifrenizi tekrar girin" />
                    <span asp-validation-for="NewPasswordConfirm" class="text-danger" style="font-size:12px;"></span>
                </div>

                <button type="submit" class="btn btn-auth">
                    <i class="fas fa-save me-2"></i>Şifremi Güncelle
                </button>
            </form>
        </div>
    </div>
</body>
</html>