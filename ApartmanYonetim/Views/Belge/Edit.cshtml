@model ApartmanYonetim.Models.ViewModels.BelgeViewModel
@using ApartmanYonetim.Models.Entities
@{
    ViewData["Title"] = "Belge Düzenle";
}

<div class="page-header">
    <h4><i class="fas fa-edit me-2"></i>Belge Düzenle</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3" style="font-size:13px;">
        @foreach (var error in ViewData.ModelState.Values
            .SelectMany(v => v.Errors))
        {
            <div>
                <i class="fas fa-exclamation-circle me-1"></i>
                @error.ErrorMessage
            </div>
        }
    </div>
}

<div class="form-card" style="max-width:640px;">
    <form asp-action="Edit" method="post"
          enctype="multipart/form-data" novalidate>
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label" style="font-size:13px;">Ad *</label>
                <input name="Ad" value="@Model.Ad" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size:13px;">Kategori</label>
                <select name="Kategori" class="form-select">
                    @foreach (BelgeKategori k in
                        Enum.GetValues(typeof(BelgeKategori)))
                    {
                        <option value="@((int)k)"
                                selected="@(Model.Kategori == k)">@k</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">
                    Açıklama
                </label>
                <input name="Aciklama" value="@Model.Aciklama"
                       class="form-control" />
            </div>

            <!-- Mevcut Dosya -->
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">
                    Mevcut Dosya
                </label>
                <div style="background:#f8fafc;border-radius:10px;
                    padding:12px 16px;display:flex;
                    align-items:center;gap:12px;">
                    <i class="fas fa-file"
                       style="font-size:24px;color:#718096;"></i>
                    <div>
                        <div style="font-weight:600;font-size:13px;">
                            @ViewBag.MevcutDosyaAdi
                        </div>
                        <div style="font-size:11px;color:#718096;">
                            @ViewBag.MevcutDosyaTipi ·
                            @ViewBag.MevcutDosyaBoyutu
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yeni Dosya (Opsiyonel) -->
            <div class="col-12">
                <label class="form-label" style="font-size:13px;">
                    Dosyayı Değiştir (Opsiyonel)
                </label>
                <input type="file" name="Dosya"
                       class="form-control"
                       accept=".pdf,.doc,.docx,.xlsx,.xls,
                .jpg,.jpeg,.png,.txt,.zip"
                       onchange="dosyaSecildi(this)" />
                <div style="font-size:11px;color:#a0aec0;margin-top:4px;">
                    Yeni dosya seçmezseniz mevcut dosya korunur.
                </div>
                <div id="yeniDosyaAd"
                     style="font-size:12px;color:#27ae60;margin-top:4px;">
                </div>
            </div>

          @*   <div class="col-12">
                <div class="form-check"
                     style="background:#f8fafc;padding:12px 16px;
                    border-radius:10px;">
                    <input name="HerkesGorebilir" type="checkbox"
                           id="herkesCheck"
                           class="form-check-input"
                    @(Model.HerkesGorebilir ? "checked" : "") />
                    <label class="form-check-label" for="herkesCheck"
                           style="font-size:13px;">
                        Tüm sakinler görebilir
                    </label>
                </div>
            </div> *@

            <div class="col-12">
                <div class="form-check"
                     style="background:#f8fafc; padding:12px 16px; border-radius:10px; padding-left: 2.5rem;">

                    <input asp-for="HerkesGorebilir"
                           id="herkesCheck"
                           class="form-check-input" />

                    <label class="form-check-label" for="herkesCheck"
                           style="font-size:13px; font-weight: 500; cursor: pointer;">
                        Tüm sakinler görebilir
                    </label>
                </div>
            </div>


            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth"
                        style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function dosyaSecildi(input) {
            const dosya = input.files[0];
            if (dosya) {
                document.getElementById('yeniDosyaAd').textContent =
                    `✓ Seçilen: ${dosya.name}`;
            }
        }
    </script>
}