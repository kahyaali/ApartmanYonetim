@model List<ApartmanYonetim.Models.Entities.Block>
@{
    ViewData["Title"] = "Bloklar";
}


<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-th-large me-2"></i>Bloklar</h4>
    
    <a asp-action="Create" class="btn btn-sm"
           style="background:#1e3a5f;color:#fff;border-radius:8px;">
        <i class="fas fa-plus me-1"></i>Yeni Blok
    </a>
    <button onclick="window.print()"
            class="btn btn-sm btn-outline-secondary no-print">
        <i class="fas fa-print me-1"></i>Yazdır
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" style="font-size:13px;">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Özet -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#e8f4fd;">
                    <i class="fas fa-th-large" style="color:#2d6a9f;"></i>
                </div>
                <div>
                    <div class="stat-number">@Model.Count</div>
                    <div class="stat-label">Toplam Blok</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#eafaf1;">
                    <i class="fas fa-building" style="color:#27ae60;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.ToplamDaire</div>
                    <div class="stat-label">Toplam Daire</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#fdf6ec;">
                    <i class="fas fa-door-open" style="color:#e67e22;"></i>
                </div>
                <div>
                    <div class="stat-number">@ViewBag.DoluDaire</div>
                    <div class="stat-label">Dolu Daire</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    @foreach (var blok in Model)
    {
        var doluSayi = blok.Apartments.Count(a => a.Dolu);
        var toplamSayi = blok.Apartments.Count;
        var dolulukOrani = toplamSayi > 0 ? (int)((double)doluSayi / toplamSayi * 100) : 0;

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div style="font-size:18px;font-weight:700;color:#1e3a5f;">
                            @blok.Ad
                        </div>
                        @if (!string.IsNullOrEmpty(blok.Aciklama))
                        {
                            <div style="font-size:12px;color:#718096;">@blok.Aciklama</div>
                        }
                    </div>
                    @if (blok.AktifMi)
                    {
                        <span class="badge" style="background:#eafaf1;color:#27ae60;font-size:11px;">
                            Aktif
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" style="font-size:11px;">Pasif</span>
                    }
                </div>

                <!-- Doluluk Bar -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1" style="font-size:12px;color:#718096;">
                        <span>Doluluk</span>
                        <span>@doluSayi / @toplamSayi daire</span>
                    </div>
                    <div style="background:#e2e8f0;border-radius:20px;height:8px;">
                        <div style="width:@dolulukOrani%;background:#1e3a5f;
                            border-radius:20px;height:8px;transition:width 0.3s;">
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Detail" asp-route-id="@blok.Id"
                           class="btn btn-sm flex-grow-1"
                           style="background:#e8f4fd;color:#2d6a9f;border-radius:8px;font-size:12px;">
                        <i class="fas fa-eye me-1"></i>Daireleri Gör
                    </a>
                    <a asp-action="Edit" asp-route-id="@blok.Id"
                           class="btn btn-sm btn-outline-primary" style="font-size:12px;">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@blok.Id" method="post" class="d-inline">          
                        <button type="button"
                                onclick="blokSil(@blok.Id, '@blok.Ad')"
                                class="btn btn-sm btn-outline-danger"
                                style="font-size:11px;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

     @section Scripts {
    <script>

        function blokSil(id, ad) {
               showConfirm(`"${ad}" silmek istediğinize emin misiniz?`)
                   .then(onay => {
                       if (!onay) return;
                       const form = document.createElement('form');
                       form.method = 'POST';
                       form.action = `/Block/Delete/${id}`;
                       const token = document.querySelector(
                           'input[name="__RequestVerificationToken"]')?.value;
                       if (token) {
                           const inp = document.createElement('input');
                           inp.type = 'hidden';
                           inp.name = '__RequestVerificationToken';
                           inp.value = token;
                           form.appendChild(inp);
                       }
                       document.body.appendChild(form);
                       form.submit();
                   });
           }
    </script>
}