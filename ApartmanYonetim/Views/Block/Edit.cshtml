@model ApartmanYonetim.Models.Entities.Block
@{
    ViewData["Title"] = "Blok Düzenle";
}

<!-- Yazdırma başlığı — ekranda gizli, baskıda görünür -->
<div class="print-header">
    <h3 style="color:#1e3a5f;margin:0;">Apartman Yönetim Sistemi</h3>
    <p style="color:#718096;margin:4px 0 0;">
        Ödemeler Raporu — @DateTime.Now.ToString("dd MMMM yyyy HH:mm",
                    new System.Globalization.CultureInfo("tr-TR"))
    </p>
</div>

<div class="page-header">
    <h4><i class="fas fa-edit me-2"></i>Blok Düzenle</h4>
  
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Blok Adı</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" style="font-size:13px;">Açıklama</label>
                <input asp-for="Aciklama" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="AktifMi" class="form-check-input" />
                    <label class="form-check-label" style="font-size:13px;">Aktif</label>
                </div>
            </div>
            <div class="col-12 mt-2">
                <button type="submit" class="btn btn-auth" style="width:auto;padding:10px 32px;">
                    <i class="fas fa-save me-2"></i>Güncelle
                </button>
            </div>
        </div>
    </form>
</div>